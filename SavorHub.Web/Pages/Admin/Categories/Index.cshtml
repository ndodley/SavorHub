@page
@model SavorHub.Web.Pages.Admin.Categories.IndexModel

<div class="container py-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h2 class="text-primary mb-0">
			<i class="bi bi-tags me-2"></i>Category List
		</h2>
		<a asp-page="create" class="btn btn-warning">
			<i class="bi bi-plus-square me-1"></i> Create New Category
		</a>
	</div>

	<div class="admin-card overflow-hidden">
		<table class="table table-hover table-striped table-bordered mb-0" style="width:100%">
			<thead class="admin-thead">
				<tr>
					<th style="width:50%">Category Name</th>
					<th style="width:30%">Display Order</th>
					<th class="text-center">Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var obj in Model.Categories)
				{
					<tr>
						<td class="align-middle fw-semibold">@obj.Name</td>
						<td class="align-middle">@obj.DisplayOrder</td>
						<td class="text-center align-middle">
							<a asp-page="Edit" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-warning me-1">
								<i class="bi bi-pencil-square"></i> Edit
							</a>
							<a asp-page="Delete" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-danger">
								<i class="bi bi-trash-fill"></i> Delete
							</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>
