@page "{id:int}"
@model SavorHub.Web.Pages.Admin.Reviews.EditModel

@{
    ViewData["Title"] = "Edit Review";
}

<div class="container py-4">
    <form method="post">
        <input asp-for="ReviewId" hidden />

        <div class="admin-card p-4">
            <h2 class="text-primary mb-1">
                <i class="bi bi-pencil-square me-2"></i>Edit Review
            </h2>
            <hr />

            <div class="mb-3">
                <label class="form-label fw-semibold">Menu Item</label>
                <div class="d-flex align-items-center gap-2">
                    <a asp-page="/Customer/Menu/Details" asp-route-id="@Model.Review.MenuItemId" class="d-inline-block" tabindex="-1" aria-hidden="true">
                        @if (!string.IsNullOrWhiteSpace(Model.Review.MenuItem?.Image))
                        {
                            <img src="@Model.Review.MenuItem.Image" alt="@Model.Review.MenuItem?.Name" style="width:64px;height:64px;object-fit:cover;border-radius:10px;" />
                        }
                        else
                        {
                            <div class="app-food-type-badge d-flex align-items-center justify-content-center" style="width:64px;height:64px;border-radius:10px;">
                                <i class="bi bi-image fs-4"></i>
                            </div>
                        }
                    </a>
                    <div>
                        <a asp-page="/Customer/Menu/Details" asp-route-id="@Model.Review.MenuItemId" class="text-decoration-none">
                            <span class="fw-semibold">@Model.Review.MenuItem?.Name</span>
                        </a>
                        <div class="text-muted" style="font-size:0.9rem;">@Model.Review.MenuItem?.Category?.Name • @Model.Review.MenuItem?.FoodType?.Name</div>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">User</label>
                <input value="@Model.Review.ApplicationUser?.Name" class="form-control" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="Rating" class="form-label fw-semibold"></label>
                <input asp-for="Rating" class="form-control" type="number" min="1" max="5" />
                <span asp-validation-for="Rating" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Content" class="form-label fw-semibold"></label>
                <textarea asp-for="Content" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Content" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning" style="min-width:130px">
                    <i class="bi bi-check-lg me-1"></i> Update
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary" style="min-width:130px">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
