@page
@model SavorHub.Web.Pages.Admin.FoodTypes.DeleteModel

<div class="container py-4">
	<form method="post">
		<input hidden asp-for="FoodType.Id" />
		<div class="admin-card p-4">
			<h2 class="text-primary mb-1">
				<i class="bi bi-trash-fill me-2"></i>Delete Food Type
			</h2>
			<hr />
			<div class="alert alert-warning">
				Are you sure you want to delete this food type?
			</div>
			<div class="mb-4">
				<label asp-for="FoodType.Name" class="form-label fw-semibold"></label>
				<input asp-for="FoodType.Name" disabled class="form-control" />
			</div>
			<div class="d-flex gap-2">
				<button type="submit" class="btn btn-danger" style="min-width:130px;">
					<i class="bi bi-trash-fill me-1"></i> Delete
				</button>
				<a asp-page="Index" class="btn btn-outline-secondary" style="min-width:130px;">
					<i class="bi bi-arrow-left me-1"></i> Back to List
				</a>
			</div>
		</div>
	</form>
</div>

@section Scripts {
	@{
		<partial name="_ValidationScriptsPartial" />
	}
}