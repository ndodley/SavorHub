@page
@model SavorHub.Web.Pages.Customer.Order.MyOrdersModel

@{
    ViewData["Title"] = "My Orders";
}

<h2>My Orders</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Order Date</th>
            <th>Order Total</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.OrderHeaderList)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.OrderDate.ToString("MM/dd/yyyy")</td>
                <td>@order.OrderTotal.ToString("C")</td>
                <td>@order.Status</td>
                <td>
                    <a asp-page="/Customer/Order/OrderDetails" asp-route-id="@order.Id" class="btn btn-primary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>