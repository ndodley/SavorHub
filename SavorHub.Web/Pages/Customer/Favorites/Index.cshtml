@page
@model SavorHub.Web.Pages.Customer.Favorites.IndexModel
@{
    ViewData["Title"] = "My Favorites";

    var favoritesByCategory = Model.Favorites
        .Where(f => f.MenuItem != null)
        .GroupBy(f => f.MenuItem!.CategoryId)
        .ToDictionary(g => g.Key, g => g.ToList());
}

<div class="container pb-4">
    <div class="d-flex align-items-end justify-content-between flex-wrap gap-2 mb-4">
        <div>
            <h1 class="fw-bold mb-1">My Favourites</h1>
            <p class="text-muted mb-0">Your saved items, grouped by category.</p>
        </div>
        <a asp-page="/Customer/Menu/Index" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-2"></i>Back to Menu
        </a>
    </div>

    @if (!Model.Favorites.Any())
    {
        <div class="card app-card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-heart" style="font-size:3rem;"></i>
                <h4 class="fw-bold mt-3 mb-2">No favourites yet</h4>
                <p class="text-muted mb-3">Tap the heart on any menu item to save it here.</p>
                <a asp-page="/Customer/Menu/Index" class="btn btn-warning text-dark fw-semibold">
                    Browse Menu
                </a>
            </div>
        </div>
    }
    else
    {
        @foreach (var category in Model.CategoryList)
        {
            if (!favoritesByCategory.TryGetValue(category.Id, out var favs) || favs.Count == 0)
            {
                continue;
            }

            var chunks = favs
                .Select((fav, idx) => new { fav, idx })
                .GroupBy(x => x.idx / 3)
                .Select(g => g.Select(x => x.fav).ToList())
                .ToList();

            var carouselId = $"favoritesCarousel_{category.Id}";

            <section class="mb-5">
                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                    <div>
                        <h2 class="fw-bold mb-1">@category.Name</h2>
                        <p class="text-muted mb-0">@favs.Count item(s)</p>
                    </div>
                    @if (chunks.Count > 1)
                    {
                        <div class="d-flex gap-2">
                            <button class="btn btn-secondary btn-sm px-3" type="button" data-bs-target="#@carouselId" data-bs-slide="prev" aria-label="Previous">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <button class="btn btn-secondary btn-sm px-3" type="button" data-bs-target="#@carouselId" data-bs-slide="next" aria-label="Next">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    }
                </div>

                <div id="@carouselId" class="carousel slide" data-bs-ride="false" data-bs-touch="false">
                    <div class="carousel-inner pb-2">
                        @for (int i = 0; i < chunks.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <div class="row g-4">
                                    @foreach (var fav in chunks[i])
                                    {
                                        var item = fav.MenuItem!;

                                        <div class="col-12 col-md-4" data-ajax-region="fav-item-@fav.Id" data-ajax-remove-if-missing>
                                            <div class="position-relative h-100">
                                                <div class="card h-100 shadow-sm border-0 hover-card modern-menu-card d-flex flex-column">
                                                    <a asp-page="/Customer/Menu/Details" asp-route-id="@item.Id" class="text-decoration-none text-reset d-flex flex-column flex-grow-1">
                                                        <div class="menu-card-img-wrap position-relative">
                                                            <img src="@item.Image" class="menu-card-img" alt="@item.Name" />
                                                            <span class="position-absolute top-0 end-0 m-2 badge bg-warning text-dark fw-semibold">
                                                                @item.Category.Name
                                                            </span>
                                                        </div>
                                                        <div class="card-body d-flex flex-column flex-grow-1">
                                                            <div class="d-flex align-items-start justify-content-between gap-2">
                                                                <h5 class="card-title fw-semibold mb-1">@item.Name</h5>
                                                                <span class="app-price fw-bold fs-5">$@item.Price</span>
                                                            </div>
                                                            <span class="badge app-food-type-badge mb-2" style="width:fit-content;">
                                                                @item.FoodType.Name
                                                            </span>
                                                            <p class="text-muted small mb-0 menu-card-desc">
                                                                @Html.Raw(item.Description)
                                                            </p>
                                                        </div>
                                                    </a>
                                                    <div class="card-footer bg-transparent border-0 pt-0" data-ajax-region="cart-@item.Id">
                                                        @if (Model.CartByMenuItemId.TryGetValue(item.Id, out var cartEntry))
                                                        {
                                                            <div class="d-flex align-items-center justify-content-center gap-3 mb-2">
                                                                <form method="post" asp-page-handler="DecrementCart" data-ajax-form>
                                                                    <input type="hidden" name="menuItemId" value="@item.Id" />
                                                                    <button type="submit" class="btn cart-qty-btn" aria-label="Decrease quantity">
                                                                        <i class="bi bi-dash"></i>
                                                                    </button>
                                                                </form>
                                                                <span class="fw-semibold cart-qty-value">@cartEntry.Count</span>
                                                                <form method="post" asp-page-handler="IncrementCart" data-ajax-form>
                                                                    <input type="hidden" name="menuItemId" value="@item.Id" />
                                                                    <button type="submit" class="btn cart-qty-btn" aria-label="Increase quantity">
                                                                        <i class="bi bi-plus"></i>
                                                                    </button>
                                                                </form>
                                                            </div>
                                                            <form method="post" asp-page-handler="RemoveCart" data-ajax-form>
                                                                <input type="hidden" name="menuItemId" value="@item.Id" />
                                                                <button type="submit" class="btn btn-outline-danger w-100 fw-semibold">
                                                                    <i class="bi bi-cart-x me-2"></i>Remove from Cart
                                                                </button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <form method="post" asp-page-handler="AddToCart" data-ajax-form>
                                                                <input type="hidden" name="menuItemId" value="@item.Id" />
                                                                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                                                                    <i class="bi bi-cart-plus me-2"></i>Add to Cart
                                                                </button>
                                                            </form>
                                                        }
                                                    </div>
                                                </div>
                                                <form method="post" asp-page-handler="Remove"
                                                    class="position-absolute top-0 start-0 m-2" style="z-index:2;"
                                                    onsubmit="return confirm('Remove from favourites?');" data-ajax-form>
                                                    <input type="hidden" name="id" value="@fav.Id" />
                                                    <button type="submit" class="btn btn-sm rounded-pill card-icon-btn" title="Remove favourite" aria-label="Remove favourite">
                                                        <i class="bi bi-heart-fill text-danger"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
    }
</div>
