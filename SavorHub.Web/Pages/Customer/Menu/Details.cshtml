@page
@model SavorHub.Web.Pages.Customer.Menu.DetailsModel

<div class="container py-4">

    <!-- ── Item card ── -->
    <div class="card app-card details-card shadow-sm mb-4" data-ajax-region="item-@Model.ShoppingCart.MenuItemId">
        <div class="card-header details-item-header">
            <div class="row align-items-center">
                <div class="col-12 col-md-8 d-flex align-items-center gap-2">
                    <h1 class="mb-0 fw-bold">@Model.ShoppingCart.MenuItem.Name</h1>
                    <form method="post" asp-page-handler="ToggleFavorite" asp-route-id="@Model.ShoppingCart.MenuItemId" data-ajax-form>
                        <button type="submit" class="btn btn-link p-0 ms-1" title="Toggle Favourite" aria-label="Toggle Favourite">
                            @if (Model.IsFavorite)
                            {
                                <i class="bi bi-heart-fill text-danger fs-3"></i>
                            }
                            else
                            {
                                <i class="bi bi-heart fs-3"></i>
                            }
                        </button>
                    </form>
                </div>
                <div class="col-12 col-md-4 text-md-end">
                    <h2 class="app-price fw-bold mb-0">$@Model.ShoppingCart.MenuItem.Price</h2>
                </div>
            </div>
        </div>
        @if (Model.CartEntry == null)
        {
            <!-- Empty form: the quantity input and the Add to Cart button live outside it
                 (down in the card body / footer) and reference it via the HTML5 form=
                 attribute, since they can't be nested inside this form and the footer's
                 form at the same time. -->
            <form method="post" id="addToCartForm" data-ajax-form>
                <input asp-for="ShoppingCart.MenuItemId" type="hidden" />
                <input asp-for="ShoppingCart.ApplicationUserId" type="hidden" />
            </form>
        }
        <div class="card-body">
            <div class="row g-4">
                <div class="col-12 col-lg-8">
                    <div class="mb-3">
                        <span class="badge bg-warning text-dark p-2 me-2">@Model.ShoppingCart.MenuItem.Category.Name</span>
                        <span class="badge app-food-type-badge p-2">@Model.ShoppingCart.MenuItem.FoodType.Name</span>
                    </div>
                    <h5 class="details-section-label mb-2">Description</h5>
                    <p class="mb-4">@Html.Raw(Model.ShoppingCart.MenuItem.Description)</p>
                    @if (Model.CartEntry == null)
                    {
                        <div style="max-width:200px;">
                            <label asp-for="ShoppingCart.Count" class="form-label details-section-label">Quantity</label>
                            <input asp-for="ShoppingCart.Count" type="number" min="1" max="100" class="form-control" form="addToCartForm" />
                            <span asp-validation-for="ShoppingCart.Count" class="text-danger small"></span>
                        </div>
                    }
                </div>
                <div class="col-12 col-lg-4 text-center">
                    <div class="details-hero-img-wrap">
                        <img src="@Model.ShoppingCart.MenuItem.Image"
                             class="details-hero-img"
                             alt="@Model.ShoppingCart.MenuItem.Name" />
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <a asp-page="Index" class="btn btn-success w-100 py-3 fw-semibold details-action-btn">
                        <i class="bi bi-arrow-left me-2"></i>Back to Menu
                    </a>
                </div>
                <div class="col-12 col-md-6">
                    @if (Model.CartEntry != null)
                    {
                        <div class="d-flex align-items-center justify-content-center gap-3 mb-2">
                            <form method="post" asp-page-handler="DecrementCart" asp-route-id="@Model.ShoppingCart.MenuItemId" data-ajax-form>
                                <button type="submit" class="btn cart-qty-btn" aria-label="Decrease quantity">
                                    <i class="bi bi-dash"></i>
                                </button>
                            </form>
                            <span class="fw-semibold cart-qty-value">@Model.CartEntry.Count</span>
                            <form method="post" asp-page-handler="IncrementCart" asp-route-id="@Model.ShoppingCart.MenuItemId" data-ajax-form>
                                <button type="submit" class="btn cart-qty-btn" aria-label="Increase quantity">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </form>
                        </div>
                        <form method="post" asp-page-handler="RemoveCart" asp-route-id="@Model.ShoppingCart.MenuItemId" data-ajax-form>
                            <button type="submit" class="btn btn-outline-danger w-100 py-3 fw-semibold details-action-btn">
                                <i class="bi bi-cart-x me-2"></i>Remove from Cart
                            </button>
                        </form>
                    }
                    else
                    {
                        <button type="submit" form="addToCartForm" class="btn btn-primary w-100 py-3 fw-semibold details-action-btn">
                            <i class="bi bi-cart-plus me-2"></i>Add to Cart
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ── Reviews ── -->
    <div class="card app-card details-card shadow-sm" data-ajax-region="reviews-@Model.ShoppingCart.MenuItemId">
        <div class="card-header details-review-header">
            <h3 class="mb-0 fw-bold details-review-title">
                <i class="bi bi-star-fill text-warning"></i> Customer Reviews
                @if (Model.Reviews.Any())
                {
                    <span class="badge bg-warning text-dark ms-2 details-review-badge">
                        @Model.AverageRating.ToString("F1") / 5.0 (@Model.Reviews.Count reviews)
                    </span>
                }
            </h3>
        </div>
            <div class="card-body">
                <!-- Add Review Form -->
                        <div class="details-review-form-panel mb-4">
                            <h5 class="details-section-label mb-3">Write a Review</h5>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form method="post" asp-page-handler="AddReview" data-ajax-form>
                                    <input asp-for="NewReview.MenuItemId" type="hidden" value="@Model.ShoppingCart.MenuItemId" />
                                    <div class="mb-3">
                                        <label class="form-label details-section-label">Rating</label>
                                        <div class="d-flex flex-wrap gap-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <input type="radio" class="btn-check" name="NewReview.Rating" id="star@(i)" value="@i" checked="@(Model.NewReview != null && Model.NewReview.Rating == i ? "checked" : null)" />
                                                <label class="btn btn-outline-warning details-rating-btn" for="star@(i)">
                                                    <i class="bi bi-star-fill"></i> @i
                                                </label>
                                            }
                                        </div>
                                        <span asp-validation-for="NewReview.Rating" class="text-danger d-block mt-1"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="NewReview.Content" class="form-label details-section-label">Your Review</label>
                                        <textarea asp-for="NewReview.Content" class="form-control" rows="4"
                                                  placeholder="Share your experience with this item..."></textarea>
                                        <span asp-validation-for="NewReview.Content" class="text-danger"></span>
                                    </div>
                                     <button type="submit" class="btn btn-primary fw-semibold details-action-btn rounded-pill px-4">
                                        <i class="bi bi-send me-2"></i>Submit Review
                                    </button>
                                </form>
                            }
                            else
                            {
                                <p class="text-muted">
                                    <a asp-area="Identity" asp-page="/Account/Login">Sign in</a> to write a review.
                                </p>
                            }
                        </div>

                        @if (Model.Reviews.Any())
                        {
                            <h5 class="details-section-label mb-3">All Reviews</h5>
                            @foreach (var review in Model.Reviews)
                            {
                                <div class="card app-card details-review-item mb-3">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="details-review-avatar">@(string.IsNullOrEmpty(review.ApplicationUser.Name) ? "?" : review.ApplicationUser.Name.Substring(0, 1).ToUpper())</span>
                                            <h6 class="fw-semibold mb-0">
                                                @review.ApplicationUser.Name
                                                <span class="text-muted fw-normal small">— @review.Date.ToString("MMM dd, yyyy")</span>
                                            </h6>
                                        </div>
                                        <div class="mb-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                            }
                                            <span class="ms-2 badge bg-secondary">@review.Rating/5</span>
                                        </div>
                                        <p class="mb-2">@review.Content</p>
                                        @if (review.UserId == Model.CurrentUserId)
                                        {
                                            <details class="mt-2">
                                                <summary class="btn btn-sm btn-outline-secondary">Edit my review</summary>
                                                <div class="mt-3">
                                                    <form method="post" asp-page-handler="UpdateReview" data-ajax-form
                                                          asp-route-id="@Model.ShoppingCart.MenuItemId"
                                                          asp-route-reviewId="@review.Id">
                                                        <div class="mb-2">
                                                            <label class="form-label">Rating</label>
                                                            <input class="form-control" type="number" min="1" max="5"
                                                                   name="NewReview.Rating" value="@review.Rating" />
                                                        </div>
                                                        <div class="mb-2">
                                                            <label class="form-label">Content</label>
                                                            <textarea class="form-control" rows="3" name="NewReview.Content">@review.Content</textarea>
                                                        </div>
                                                         <button type="submit" class="btn btn-sm btn-primary">Update</button>
                                                    </form>
                                                    <form class="mt-2" method="post" asp-page-handler="DeleteReview"
                                                          asp-route-id="@Model.ShoppingCart.MenuItemId"
                                                          asp-route-reviewId="@review.Id"
                                                          onsubmit="return confirm('Delete your review?');" data-ajax-form>
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                    </form>
                                                </div>
                                            </details>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-chat-square-text" style="font-size:3rem;"></i>
                                <p class="mt-2">No reviews yet. Be the first to review this item!</p>
                            </div>
                        }
                    </div>
                </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
