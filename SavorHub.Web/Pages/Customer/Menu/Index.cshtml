@page
@model SavorHub.Web.Pages.Customer.Menu.IndexModel

@{
	var categoryGroups = Model.MenuItemList
		.GroupBy(m => m.CategoryId)
		.ToDictionary(g => g.Key, g => g.ToList());
}

<div class="container pb-4">
	<div class="d-flex align-items-end justify-content-between flex-wrap gap-2 mb-4">
		<div>
			<h1 class="fw-bold mb-1">Menu</h1>
			<p class="text-muted mb-0">Browse by category and scroll through dishes.</p>
		</div>
		<a asp-page="/Customer/Favorites/Index" class="btn btn-outline-primary">
			<i class="bi bi-heart me-2"></i>Favourites
		</a>
	</div>

	@foreach (var category in Model.CategoryList)
	{
		if (!categoryGroups.TryGetValue(category.Id, out var items) || items.Count == 0)
		{
			continue;
		}

		var chunks = items
			.Select((item, idx) => new { item, idx })
			.GroupBy(x => x.idx / 3)
			.Select(g => g.Select(x => x.item).ToList())
			.ToList();

		var carouselId = $"categoryCarousel_{category.Id}";

		<section class="mb-5">
			<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
				<div>
					<h2 class="fw-bold mb-1">@category.Name</h2>
					<p class="text-muted mb-0">@items.Count item(s)</p>
				</div>
				@if (chunks.Count > 1)
				{
					<div class="d-flex gap-2">
						<button class="btn btn-secondary btn-sm px-3" type="button" data-bs-target="#@carouselId" data-bs-slide="prev" aria-label="Previous">
							<i class="bi bi-chevron-left"></i>
						</button>
						<button class="btn btn-secondary btn-sm px-3" type="button" data-bs-target="#@carouselId" data-bs-slide="next" aria-label="Next">
							<i class="bi bi-chevron-right"></i>
						</button>
					</div>
				}
			</div>

			<div id="@carouselId" class="carousel slide" data-bs-ride="false" data-bs-touch="false">
				<div class="carousel-inner pb-2">
					@for (int i = 0; i < chunks.Count; i++)
					{
						<div class="carousel-item @(i == 0 ? "active" : "")">
							<div class="row g-4">
								@foreach (var menuItem in chunks[i])
								{
									var rating = Model.MenuItemRatings[menuItem.Id];
									var isFav = Model.FavoriteMenuItemIds.Contains(menuItem.Id);

									<div class="col-12 col-md-4">
										<div class="position-relative h-100">
											<div class="card h-100 shadow-sm border-0 hover-card modern-menu-card d-flex flex-column">
												<a asp-page="Details" asp-route-id="@menuItem.Id" class="text-decoration-none text-reset d-flex flex-column flex-grow-1">
													<div class="menu-card-img-wrap position-relative">
														<img src="@menuItem.Image" class="menu-card-img" alt="@menuItem.Name" />
														<span class="position-absolute top-0 end-0 m-2 badge bg-warning text-dark fw-semibold">
															@menuItem.Category.Name
														</span>
													</div>
													<div class="card-body d-flex flex-column flex-grow-1">
														<div class="d-flex align-items-start justify-content-between gap-2">
															<h5 class="card-title fw-semibold mb-1">@menuItem.Name</h5>
															<span class="app-price fw-bold fs-5">$@menuItem.Price</span>
														</div>
														<span class="badge app-food-type-badge mb-2" style="width:fit-content;">
															@menuItem.FoodType.Name
														</span>
														<div class="d-flex align-items-center gap-1 mb-2">
															@for (int s = 1; s <= 5; s++)
															{
																if (s <= rating.AverageRating)
																{
																	<i class="bi bi-star-fill text-warning small"></i>
																}
																else if (s - 0.5 <= rating.AverageRating)
																{
																	<i class="bi bi-star-half text-warning small"></i>
																}
																else
																{
																	<i class="bi bi-star text-muted small"></i>
																}
															}
															@if (rating.ReviewCount > 0)
															{
																<span class="text-muted small ms-1">(@rating.ReviewCount)</span>
															}
														</div>
														<p class="text-muted small mb-0 menu-card-desc">
															@Html.Raw(menuItem.Description)
														</p>
													</div>
												</a>
												<div class="card-footer bg-transparent border-0 pt-0" data-ajax-region="cart-@menuItem.Id">
													@if (Model.CartByMenuItemId.TryGetValue(menuItem.Id, out var cartEntry))
													{
														<div class="d-flex align-items-center justify-content-center gap-3 mb-2">
															<form method="post" asp-page-handler="DecrementCart" data-ajax-form>
																<input type="hidden" name="menuItemId" value="@menuItem.Id" />
																<button type="submit" class="btn cart-qty-btn" aria-label="Decrease quantity">
																	<i class="bi bi-dash"></i>
																</button>
															</form>
															<span class="fw-semibold cart-qty-value">@cartEntry.Count</span>
															<form method="post" asp-page-handler="IncrementCart" data-ajax-form>
																<input type="hidden" name="menuItemId" value="@menuItem.Id" />
																<button type="submit" class="btn cart-qty-btn" aria-label="Increase quantity">
																	<i class="bi bi-plus"></i>
																</button>
															</form>
														</div>
														<form method="post" asp-page-handler="RemoveCart" data-ajax-form>
															<input type="hidden" name="menuItemId" value="@menuItem.Id" />
															<button type="submit" class="btn btn-outline-danger w-100 fw-semibold">
																<i class="bi bi-cart-x me-2"></i>Remove from Cart
															</button>
														</form>
													}
													else
													{
														<form method="post" asp-page-handler="AddToCart" data-ajax-form>
															<input type="hidden" name="menuItemId" value="@menuItem.Id" />
															<button type="submit" class="btn btn-primary w-100 fw-semibold">
																<i class="bi bi-cart-plus me-2"></i>Add to Cart
															</button>
														</form>
													}
												</div>
											</div>
											<form method="post" asp-page-handler="ToggleFavorite" class="position-absolute top-0 start-0 m-2" style="z-index:2;" data-ajax-form data-ajax-region="fav-@menuItem.Id">
												<input type="hidden" name="menuItemId" value="@menuItem.Id" />
												<button type="submit" class="btn btn-sm rounded-pill card-icon-btn" title="Toggle Favourite" aria-label="Toggle Favourite">
													@if (isFav)
													{
														<i class="bi bi-heart-fill text-danger"></i>
													}
													else
													{
														<i class="bi bi-heart text-muted"></i>
													}
												</button>
											</form>
										</div>
									</div>
								}
							</div>
						</div>
					}
				</div>
			</div>
		</section>
	}
</div>
