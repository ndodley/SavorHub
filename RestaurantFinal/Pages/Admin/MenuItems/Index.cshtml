@page
@model RestaurantFinal.Pages.Admin.MenuItems.IndexModel

<div class="container p-3">
	<div class="row pt-4">
		<div class="col-6">
			<h2 class="text-primary">Menu Item List</h2>
		</div>
		<div class="col-6 text-end">
			<a asp-page="upsert" class="btn btn-primary">
				<i class="bi bi-plus-square"></i> &nbsp;Create New Menu Item
			</a>
		</div>
	</div>

	<br /><br />

	<table id="DT_load" class="table table-bordered table-striped" style="width:100%">
		<thead>
			<tr>
				<th>Name</th>
				<th>Price</th>
				<th>Category</th>
				<th>Food Type</th>
				<th>Image</th>
				<th></th>
			</tr>
		</thead>
	</table>

	<div id="CSV" class="mt-4">
		<h2>Download/Upload CSV File</h2>
		<a href="/api/MenuItem/DownloadSampleCSV" class="btn btn-primary">Download Sample CSV</a>
		<input type="file" id="csvFileInput" class="form-control-file" />
		<button id="uploadCSVButton" class="btn btn-primary mt-2">Upload CSV</button>
	</div>

	<div id="csvTableContainer" class="mt-4" style="display:none;">
		<h3>CSV Input Data</h3>
		<table id="csvTable" class="table table-bordered table-striped" style="width:100%"></table>
	</div>

</div>

@section Scripts {
	<script src="~/js/menuItem.js"></script>
}