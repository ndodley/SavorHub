@page
@model RestaurantFinal.Pages.Admin.Order.ManageOrderModel
@using Restaurant.Utility

<div class="container py-4">
    <h2 class="text-primary mb-4">
        <i class="bi bi-clipboard-check me-2"></i>Manage Orders
    </h2>
    <form method="post">
        @foreach (var item in Model.OrderDetailVM)
        {
            <div class="admin-card p-4 mb-4">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <p class="text-muted text-uppercase small fw-bold mb-2">
                            Order <span class="text-primary">#@item.OrderHeader.Id</span>
                        </p>
                        <ul class="list-unstyled mb-0">
                            @foreach (var details in item.OrderDetails)
                            {
                                <li class="d-flex align-items-center gap-1 py-1">
                                    <i class="bi bi-dot text-warning fs-5"></i>
                                    <span>@details.Name <span class="text-muted">x @details.Count</span></span>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="input-group mb-2">
                            <span class="input-group-text"><i class="bi bi-clock me-1"></i> Pickup</span>
                            <input type="text" value="@item.OrderHeader.PickUpTime" class="form-control" readonly />
                        </div>
                        <textarea readonly asp-for="@item.OrderHeader.Comments" class="form-control rounded" rows="3" placeholder="No special instructions"></textarea>
                    </div>
                    <div class="col-12 col-md-4 d-flex flex-column justify-content-center gap-2">
                        @if (item.OrderHeader.Status == SD.StatusSubmitted)
                        {
                            <button type="submit" class="btn btn-warning w-100"
                                    asp-page-handler="OrderInProcess" asp-route-orderId="@item.OrderHeader.Id">
                                <i class="bi bi-check-square me-1"></i> Start Cooking
                            </button>
                        }
                        @if (item.OrderHeader.Status == SD.StatusInProcess)
                        {
                            <button type="submit" class="btn btn-success w-100"
                                    asp-page-handler="OrderReady" asp-route-orderId="@item.OrderHeader.Id">
                                <i class="bi bi-emoji-laughing me-1"></i> Order Ready
                            </button>
                        }
                        <button type="submit" class="btn btn-outline-danger w-100"
                                asp-page-handler="OrderCancel" asp-route-orderId="@item.OrderHeader.Id">
                            <i class="bi bi-x-square-fill me-1"></i> Cancel Order
                        </button>
                    </div>
                </div>
            </div>
        }
    </form>
</div>
