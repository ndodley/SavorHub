@page
@model RestaurantFinal.Pages.Admin.Categories.EditModel

<div class="container py-4">
	<form method="post">
		<input hidden asp-for="Category.Id" />
		<div class="admin-card p-4">
			<h2 class="text-primary mb-1">
				<i class="bi bi-pencil-square me-2"></i>Edit Category
			</h2>
			<hr />
			<div asp-validation-summary="All" class="text-danger mb-3"></div>
			<div class="mb-3">
				<label asp-for="Category.Name" class="form-label fw-semibold"></label>
				<input asp-for="Category.Name" class="form-control" />
				<span asp-validation-for="Category.Name" class="text-danger small"></span>
			</div>
			<div class="mb-4">
				<label asp-for="Category.DisplayOrder" class="form-label fw-semibold"></label>
				<input asp-for="Category.DisplayOrder" class="form-control" />
				<span asp-validation-for="Category.DisplayOrder" class="text-danger small"></span>
			</div>
			<div class="d-flex gap-2">
				<button type="submit" class="btn btn-warning" style="min-width:130px;">
					<i class="bi bi-check-lg me-1"></i> Update
				</button>
				<a asp-page="Index" class="btn btn-outline-secondary" style="min-width:130px;">
					<i class="bi bi-arrow-left me-1"></i> Back to List
				</a>
			</div>
		</div>
	</form>
</div>

@section Scripts {
	@{
		<partial name="_ValidationScriptsPartial" />
	}
}
