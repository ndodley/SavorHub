@page "{id:int}"
@model RestaurantFinal.Pages.Admin.Reviews.EditModel

@{
    ViewData["Title"] = "Edit Review";
}

<form method="post">
    <input asp-for="ReviewId" hidden />

    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Edit Review</h2>
            <hr />
        </div>

        <div class="mb-3">
            <label class="form-label">Menu Item</label>
            <div class="d-flex align-items-center gap-2">
                <a asp-page="/Customer/Menu/Details" asp-route-id="@Model.Review.MenuItemId" class="d-inline-block" tabindex="-1" aria-hidden="true">
                    @if (!string.IsNullOrWhiteSpace(Model.Review.MenuItem?.Image))
                    {
                        <img src="@Model.Review.MenuItem.Image" alt="@Model.Review.MenuItem?.Name" style="width:64px;height:64px;object-fit:cover;border-radius:10px;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center" style="width:64px;height:64px;border-radius:10px;">
                            <i class="bi bi-image text-muted fs-4"></i>
                        </div>
                    }
                </a>
                <div>
                    <a asp-page="/Customer/Menu/Details" asp-route-id="@Model.Review.MenuItemId" class="text-decoration-none">
                        <span class="fw-semibold">@Model.Review.MenuItem?.Name</span>
                    </a>
                    <div class="text-muted" style="font-size:0.9rem;">@Model.Review.MenuItem?.Category?.Name • @Model.Review.MenuItem?.FoodType?.Name</div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">User</label>
            <input value="@Model.Review.ApplicationUser?.Name" class="form-control" disabled />
        </div>

        <div class="mb-3">
            <label asp-for="Rating" class="form-label"></label>
            <input asp-for="Rating" class="form-control" type="number" min="1" max="5" />
            <span asp-validation-for="Rating" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Content" class="form-label"></label>
            <textarea asp-for="Content" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary" style="width:150px">Update</button>
        <a asp-page="Index" class="btn btn-secondary" style="width:150px">Back to List</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
