@page
@model RestaurantFinal.Pages.Admin.Reviews.IndexModel

@{
    ViewData["Title"] = "Admin Reviews";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary mb-0">
            <i class="bi bi-star-half me-2"></i>Review List
        </h2>
    </div>

    <div class="admin-card overflow-hidden">
        <table class="table table-hover table-striped table-bordered mb-0" style="width:100%">
            <thead class="admin-thead">
                <tr>
                    <th>Menu Item</th>
                    <th>User</th>
                    <th>Rating</th>
                    <th>Date</th>
                    <th>Content</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in Model.Reviews)
                {
                    <tr>
                        <td style="width:20%" class="align-middle">
                            <div class="d-flex align-items-center gap-2">
                                <a asp-page="/Customer/Menu/Details" asp-route-id="@review.MenuItemId" class="d-inline-block" title="View menu item">
                                    @if (!string.IsNullOrWhiteSpace(review.MenuItem?.Image))
                                    {
                                        <img src="@review.MenuItem.Image" alt="@review.MenuItem?.Name" style="width:48px;height:48px;object-fit:cover;border-radius:8px;" />
                                    }
                                    else
                                    {
                                        <div class="app-food-type-badge d-flex align-items-center justify-content-center" style="width:48px;height:48px;border-radius:8px;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </a>
                                <div class="d-flex flex-column">
                                    <a asp-page="/Customer/Menu/Details" asp-route-id="@review.MenuItemId" class="text-decoration-none fw-semibold">
                                        @review.MenuItem?.Name
                                    </a>
                                    <small class="text-muted">@review.MenuItem?.Category?.Name • @review.MenuItem?.FoodType?.Name</small>
                                </div>
                            </div>
                        </td>
                        <td class="align-middle" style="width:15%">@review.ApplicationUser?.Name</td>
                        <td class="align-middle" style="width:10%">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                            }
                            <small class="text-muted d-block">(@review.Rating/5)</small>
                        </td>
                        <td class="align-middle" style="width:12%">@review.Date.ToString("MMM dd, yyyy")</td>
                        <td class="align-middle">@review.Content</td>
                        <td class="text-center align-middle" style="width:15%">
                            <a asp-page="Edit" asp-route-id="@review.Id" class="btn btn-sm btn-outline-warning me-1">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a asp-page="Delete" asp-route-id="@review.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash-fill"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
