@using Microsoft.AspNetCore.Identity
@using Restaurant.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
            <i class="bi bi-person-circle fs-5"></i>
            <span>@UserManager.GetUserName(User)</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow">
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-person me-2"></i>Profile</a></li>
            <li><a class="dropdown-item" asp-area="" asp-page="/Customer/Order/MyOrders"><i class="bi bi-bag me-2"></i>My Orders</a></li>
            <li><a class="dropdown-item" asp-area="" asp-page="/Customer/Reviews/MyReviews"><i class="bi bi-star me-2"></i>My Reviews</a></li>
            <li><a class="dropdown-item" asp-area="" asp-page="/Customer/Favorites/Index"><i class="bi bi-heart me-2"></i>My Favorites</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
                    <button id="logout" type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
