@page
@model SavorHub.Web.Pages.Customer.Cart.OrderConfirmationModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5 text-center">
                    <h1 class="h3 text-primary mb-2">Order placed successfully</h1>
                    <p class="text-muted mb-4">
                        Your order has been placed successfully.
                        Please arrive on time for hot, delicious food.
                    </p>

                    <div class="d-inline-flex align-items-center gap-2 mb-4">
                        <span class="badge text-bg-primary fs-6">Order</span>
                        <span class="fs-5 fw-semibold">#@Model.OrderId</span>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mb-4">
                        <a asp-page="/Customer/Order/MyOrders" class="btn btn-primary">
                            View my orders
                        </a>
                        <a asp-page="/Customer/Menu/Index" class="btn btn-outline-primary">
                            Continue shopping
                        </a>
                    </div>

                    <img
                        src="~/images/shopping_bag.png"
                        alt="Order placed"
                        class="img-fluid"
                        style="max-height: 420px; width: auto;" />
                </div>
            </div>

            @if (Model.Items?.Any() == true)
            {
                <div class="mt-4">
                    <h2 class="h5 fw-semibold mb-3 text-center">Items purchased</h2>
                    <div class="row g-3">
                        @foreach (var item in Model.Items)
                        {
                            var menuItemId = item.MenuItemId;
                            var image = item.MenuItem?.Image;
                            var name = item.MenuItem?.Name ?? item.Name;

                            <div class="col-12 col-sm-6 col-lg-4">
                                <a asp-page="/Customer/Menu/Details" asp-route-id="@menuItemId"
                                   class="text-decoration-none text-dark">
                                    <div class="card h-100 shadow-sm border-0">
                                        @if (!string.IsNullOrWhiteSpace(image))
                                        {
                                            <img src="@image" class="card-img-top" alt="@name"
                                                 style="height: 160px; object-fit: cover;" />
                                        }
                                        <div class="card-body">
                                            <div class="fw-semibold">@name</div>
                                            <div class="text-muted small">
                                                Qty: @item.Count · $@item.Price
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
