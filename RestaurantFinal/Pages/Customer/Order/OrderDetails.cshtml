@page "{id:int}"
@model RestaurantFinal.Pages.Customer.Order.OrderDetailsModel

@{
    ViewData["Title"] = "Order Details";
}

<h2>Order Details</h2>

<div>
    <h4>Order ID: @Model.OrderDetailVM.OrderHeader.Id</h4>
    <p>Order Date: @Model.OrderDetailVM.OrderHeader.OrderDate.ToString("MM/dd/yyyy")</p>
    <p>Order Total: @Model.OrderDetailVM.OrderHeader.OrderTotal.ToString("C")</p>
    <p>Status: @Model.OrderDetailVM.OrderHeader.Status</p>
    <p>Pick Up Time: @Model.OrderDetailVM.OrderHeader.PickUpTime.ToString("MM/dd/yyyy hh:mm tt")</p>
    <p>Comments: @Model.OrderDetailVM.OrderHeader.Comments</p>
</div>

<h3>Order Items</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Item Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderDetailVM.OrderDetails)
        {
            <tr>
                <td>@item.MenuItem.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Count</td>
                <td>$@(item.Price * item.Count)</td>
            </tr>
        }
    </tbody>
</table>