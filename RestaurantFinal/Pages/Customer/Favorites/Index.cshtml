@page
@model RestaurantFinal.Pages.Customer.Favorites.IndexModel
@{
    ViewData["Title"] = "My Favorites";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-12">
            <h2 class="text-primary">My Favorites</h2>
        </div>
    </div>

    <br />

    @if (!Model.Favorites.Any())
    {
        <div class="alert alert-info">You don't have any favorites yet.</div>
    }
    else
    {
        <div class="row">
            @foreach (var fav in Model.Favorites)
            {
                <div class="col-lg-4 col-md-6 pb-4">
                    <div class="card rounded shadow-sm app-card">
                        <a asp-page="/Customer/Menu/Details" asp-route-id="@fav.MenuItemId" class="text-decoration-none">
                            <img class="card-img-top img-fluid d-block mx-auto" src="@fav.MenuItem?.Image" alt="menuitem image">
                        </a>
                        <div class="card-body pb-1 row">
                            <div class="col-8 h5">@fav.MenuItem?.Name</div>
                            <div class="col-4 text-end"><span class="app-price h4">$@fav.MenuItem?.Price</span></div>
                        </div>
                        <div class="card-body p-1 px-3 row">
                            <div class="col-6">
                                <span class="badge p-2 border w-100 text-dark bg-warning ">@fav.MenuItem?.Category?.Name</span>
                            </div>
                            <div class="col-6 border-0">
                                <span class="badge p-2 border w-100 bg-info ">@fav.MenuItem?.FoodType?.Name</span>
                            </div>
                            <div class="col-12 p-1 pt-3">
                                <form method="post" asp-page-handler="Remove">
                                    <input type="hidden" name="id" value="@fav.Id" />
                                    <button type="submit" class="btn btn-outline-danger form-control btn-sm" style="height:40px">Remove</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
